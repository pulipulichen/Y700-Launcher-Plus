--- /dev/null
+++ b/lawnchair/src/app/lawnchair/y700/DrawerRank.java
@@ -0,0 +1,13 @@
+package app.lawnchair.y700;
+
+/** Pure ranking/layout policy shared with the host-side regression checks. */
+public final class DrawerRank {
+    private DrawerRank() {}
+    public static double score(int count, long last, long now) {
+        double ageDays = Math.max(0.0, ((double) now - last)) / 86400000.0;
+        return Math.log1p(Math.max(0, count)) + (last > 0 ? 4.0 / (1.0 + ageDays) : 0.0);
+    }
+    public static int columns(float widthDp, int minimum) {
+        return Math.max(minimum, Math.min(12, (int) (widthDp / 80)));
+    }
+}
