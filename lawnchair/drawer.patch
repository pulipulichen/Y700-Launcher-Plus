@@ -0,0 +1,68 @@
+package app.lawnchair.y700
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import app.lawnchair.preferences.getAdapter
+import app.lawnchair.preferences2.preferenceManager2
+import app.lawnchair.ui.preferences.components.controls.ClickablePreference
+import app.lawnchair.ui.preferences.components.controls.SwitchPreference
+import app.lawnchair.ui.preferences.components.layout.PreferenceGroup
+import com.android.launcher3.R
+
+@Composable
+fun DrawerPreferences() {
+    val prefs = preferenceManager2()
+    val context = LocalContext.current
+    PreferenceGroup(heading = stringResource(R.string.y700_layout)) {
+        SwitchPreference(adapter = prefs.drawerSearchAtBottom.getAdapter(), label = stringResource(R.string.y700_search_bottom))
+        SwitchPreference(adapter = prefs.drawerFrequentAtBottom.getAdapter(), label = stringResource(R.string.y700_frequent_bottom))
+        SwitchPreference(adapter = prefs.drawerAutomaticColumns.getAdapter(), label = stringResource(R.string.y700_auto_grid))
+    }
+    PreferenceGroup(heading = stringResource(R.string.y700_frequent)) {
+        SwitchPreference(adapter = prefs.drawerFrequentEnabled.getAdapter(), label = stringResource(R.string.y700_show_frequent),
+            description = stringResource(R.string.y700_local_history))
+        ClickablePreference(label = stringResource(R.string.y700_manage_pins), onClick = { manage(context, "pinned", R.string.y700_manage_pins) })
+        ClickablePreference(label = stringResource(R.string.y700_manage_excluded), onClick = { manage(context, "excluded", R.string.y700_manage_excluded) })
+        ClickablePreference(label = stringResource(R.string.y700_alias), subtitle = stringResource(R.string.y700_alias_hint), onClick = { manageAliases(context) })
+    }
+    PreferenceGroup(heading = stringResource(R.string.y700_taskbar)) {
+        ClickablePreference(label = stringResource(R.string.y700_taskbar), subtitle = stringResource(R.string.y700_taskbar_note), onClick = {
+            val intent = android.content.Intent(android.content.Intent.ACTION_MAIN).addCategory(android.content.Intent.CATEGORY_HOME).setPackage("com.zui.launcher")
+            runCatching { context.startActivity(intent) }
+        })
+    }
+}
+
+private fun installed(context: android.content.Context): List<android.content.pm.LauncherActivityInfo> =
+    context.getSystemService(android.content.pm.LauncherApps::class.java)
+        ?.getActivityList(null, android.os.Process.myUserHandle()).orEmpty().sortedBy { it.label.toString() }
+
+private fun app(info: android.content.pm.LauncherActivityInfo) = com.android.launcher3.model.data.AppInfo().apply {
+    componentName = info.componentName
+    user = info.user
+    title = info.label
+    intent = android.content.Intent(android.content.Intent.ACTION_MAIN).addCategory(android.content.Intent.CATEGORY_LAUNCHER).setComponent(info.componentName)
+}
+
+private fun manage(context: android.content.Context, kind: String, title: Int) {
+    val history = DrawerHistory(context)
+    val entries = installed(context)
+    val selected = entries.map { history.contains(kind, app(it)) }.toBooleanArray()
+    android.app.AlertDialog.Builder(context).setTitle(title)
+        .setMultiChoiceItems(entries.map { it.label }.toTypedArray(), selected) { _, index, _ -> history.toggle(kind, app(entries[index])) }
+        .setPositiveButton(android.R.string.ok, null).show()
+}
+
+private fun manageAliases(context: android.content.Context) {
+    val history = DrawerHistory(context)
+    val entries = installed(context)
+    android.app.AlertDialog.Builder(context).setTitle(R.string.y700_alias)
+        .setItems(entries.map { it.label }.toTypedArray()) { _, index ->
+            val item = app(entries[index])
+            val input = android.widget.EditText(context).apply { setSingleLine(); setText(history.alias(item)); hint = item.title }
+            android.app.AlertDialog.Builder(context).setTitle(item.title).setView(input)
+                .setPositiveButton(android.R.string.ok) { _, _ -> history.setAlias(item, input.text.toString()) }
+                .setNegativeButton(android.R.string.cancel, null).show()
+        }.show()
+}
