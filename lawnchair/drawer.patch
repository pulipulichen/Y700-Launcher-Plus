+/** Fixed drawer chrome, with independent top/bottom positions and IME-safe content bounds. */
+class SearchContainerView(context: Context, attrs: AttributeSet?) : LauncherAllAppsContainerView(context, attrs) {
+    private var frequent: LinearLayout? = null
+    private var lastColumns = -1
+    private var lastCompact = false
+    private val history = DrawerHistory(context)
+    private val prefs by lazy { PreferenceManager2.getInstance(context) }
+    private val stateListener = object : StateManager.StateListener<LauncherState> {
+        override fun onStateTransitionStart(toState: LauncherState) {
+            if (toState == LauncherState.ALL_APPS) refreshFrequent()
+        }
+        override fun onStateTransitionComplete(finalState: LauncherState) {
+            if (finalState == LauncherState.ALL_APPS) requestLayout()
+        }
+    }
     override fun createSearchUiDelegate() = LawnchairSearchUiDelegate(this)
+    override fun onFinishInflate() {
+        super.onFinishInflate()
+        frequent = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            id = R.id.y700_frequent_row
+        }.also { addView(it, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT)) }
+    }
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        context.launcher.stateManager.addStateListener(stateListener)
+        appsStore.addUpdateListener(updateListener)
+        refreshFrequent()
+    }
+    override fun onDetachedFromWindow() {
+        context.launcher.stateManager.removeStateListener(stateListener)
+        appsStore.removeUpdateListener(updateListener)
+        super.onDetachedFromWindow()
+    }
+    private val updateListener = com.android.launcher3.allapps.AllAppsStore.OnUpdateListener { refreshFrequent() }
+    private fun compactFrequent(): Boolean =
+        resources.configuration.orientation == android.content.res.Configuration.ORIENTATION_LANDSCAPE &&
+            rootWindowInsets?.let { WindowInsetsCompat.toWindowInsetsCompat(it).isVisible(WindowInsetsCompat.Type.ime()) } == true
+    private fun frequentColumns(compact: Boolean) = app.lawnchair.y700.DrawerRank.columns(
+        width / resources.displayMetrics.density / (if (compact) 2f else 1f), 1,
+    )
+    private fun frequentHeight(compact: Boolean) = if (compact) (56 * resources.displayMetrics.density).toInt()
+        else context.launcher.deviceProfile.allAppsCellHeightPx
+    fun refreshFrequent() {
+        val row = frequent ?: return
+        val compact = compactFrequent()
+        val columns = frequentColumns(compact)
+        lastColumns = columns
+        lastCompact = compact
+        row.removeAllViews()
+        val hidden = prefs.hiddenApps.firstBlocking()
+        // Private/work profiles remain in their native tabs and never leak into recommendations.
+        val apps = appsStore.apps.filter { it.user == android.os.Process.myUserHandle() }
+        history.recommendations(apps, hidden, columns).forEach { app ->
+            val icon = LayoutInflater.from(context).inflate(if (compact) R.layout.y700_frequent_compact else R.layout.all_apps_icon, row, false) as BubbleTextView
+            icon.applyFromApplicationInfo(app)
+            icon.setOnClickListener(context.launcher.itemOnClickListener)
+            icon.setOnLongClickListener(context.launcher.allAppsItemLongClickListener)
+            row.addView(icon, LinearLayout.LayoutParams(0, frequentHeight(compact), 1f))
+        }
+        requestLayout()
+    }
+    override fun onApplyWindowInsets(insets: android.view.WindowInsets): android.view.WindowInsets {
+        val result = super.onApplyWindowInsets(insets)
+        requestLayout()
+        return result
+    }
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        super.onLayout(changed, l, t, r, b)
+        val row = frequent ?: return
+        val compact = compactFrequent()
+        val columns = frequentColumns(compact)
+        if (columns != lastColumns || compact != lastCompact) post { refreshFrequent() }
+        val insets = rootWindowInsets?.let { WindowInsetsCompat.toWindowInsetsCompat(it) }
+        val bars = insets?.getInsets(WindowInsetsCompat.Type.systemBars())
+        val ime = insets?.getInsets(WindowInsetsCompat.Type.ime())?.bottom ?: 0
+        val screen = IntArray(2).also { getLocationOnScreen(it) }
+        val root = rootView
+        val rootLocation = IntArray(2).also { root.getLocationOnScreen(it) }
+        val visibleBottom = rootLocation[1] + root.height - maxOf(ime, bars?.bottom ?: 0) - screen[1]
+        var top = maxOf(paddingTop, (bars?.top ?: 0) - screen[1], 0)
+        var bottom = minOf(height - paddingBottom, visibleBottom).coerceAtLeast(top)
+        val left = paddingLeft
+        val right = width - paddingRight
+        val search = searchView
+        val searchBottom = prefs.drawerSearchAtBottom.firstBlocking()
+        val rowBottom = prefs.drawerFrequentAtBottom.firstBlocking()
+        val showRow = searchUiManager.editText?.text.isNullOrEmpty() && prefs.drawerFrequentEnabled.firstBlocking()
+        row.visibility = if (showRow) View.VISIBLE else View.GONE
+        val searchHeight = if (search.visibility == View.VISIBLE) search.measuredHeight else 0
+        val rowHeight = if (showRow) frequentHeight(compact) else 0
+        fun place(view: View, y: Int, h: Int) {
+            view.measure(MeasureSpec.makeMeasureSpec((right - left).coerceAtLeast(0), MeasureSpec.EXACTLY),
+                MeasureSpec.makeMeasureSpec(h.coerceAtLeast(0), MeasureSpec.EXACTLY))
+            view.layout(left, y, right, y + h)
+        }
+        // Same-side order is stable: row above search at bottom, search above row at top.
+        if (searchBottom) { bottom -= searchHeight; place(search, bottom, searchHeight) }
+        else { place(search, top, searchHeight); top += searchHeight }
+        if (rowBottom) { bottom -= rowHeight; place(row, bottom, rowHeight) }
+        else { place(row, top, rowHeight); top += rowHeight }
+        val header = floatingHeaderView
+        place(header, top, header.measuredHeight)
+        val content = appsRecyclerViewContainer
+        place(content, top, (bottom - top).coerceAtLeast(0))
+        if (content !== mSearchRecyclerView) place(mSearchRecyclerView, top, (bottom - top).coerceAtLeast(0))
+        // Keep the fast-scroll touch region out of the fixed row, search and IME.
+        val scrollWidth = mFastScroller.measuredWidth
+        val scrollLeft = mFastScroller.left
+        mFastScroller.measure(MeasureSpec.makeMeasureSpec(scrollWidth, MeasureSpec.EXACTLY),
+            MeasureSpec.makeMeasureSpec((bottom - top).coerceAtLeast(0), MeasureSpec.EXACTLY))
+        mFastScroller.layout(scrollLeft, top, scrollLeft + scrollWidth, bottom.coerceAtLeast(top))
+        // No tablet bottom-sheet gutter: drawer uses the available full-screen surface.
+        mBottomSheetBackground.layout(0, 0, width, height)
+    }
 }
