+package app.lawnchair.y700
+
+import android.view.View
+import android.widget.EditText
+import app.lawnchair.LawnchairLauncher
+import app.lawnchair.preferences2.PreferenceManager2
+import com.android.launcher3.AbstractFloatingView
+import com.android.launcher3.R
+import com.android.launcher3.model.data.AppInfo
+import com.android.launcher3.model.data.ItemInfo
+import com.android.launcher3.popup.SystemShortcut
+import com.patrykmichalik.opto.core.firstBlocking
+import kotlinx.coroutines.launch
+import androidx.lifecycle.lifecycleScope
+
+object DrawerShortcuts {
+    private fun action(icon: Int, label: Int, block: (LawnchairLauncher, AppInfo) -> Unit) =
+        SystemShortcut.Factory<LawnchairLauncher> { launcher, item, view ->
+            if (item !is AppInfo) null else object : SystemShortcut<LawnchairLauncher>(icon, label, launcher, item, view) {
+                override fun onClick(v: View) {
+                    AbstractFloatingView.closeAllOpenViews(launcher)
+                    block(launcher, item)
+                    (launcher.appsView as? app.lawnchair.allapps.views.SearchContainerView)?.refreshFrequent()
+                }
+            }
+        }
+    val PIN = action(R.drawable.ic_pin, R.string.y700_pin) { launcher, app -> DrawerHistory(launcher).toggle("pinned", app) }
+    val EXCLUDE = action(R.drawable.ic_block_no_shadow, R.string.y700_exclude) { launcher, app -> DrawerHistory(launcher).toggle("excluded", app) }
+    val HIDE = action(R.drawable.ic_visibility, R.string.y700_hide) { launcher, app ->
+        val pref = PreferenceManager2.getInstance(launcher).hiddenApps
+        launcher.lifecycleScope.launch { pref.set(pref.firstBlocking() + app.toComponentKey().toString()) }
+    }
+    val ALIAS = action(R.drawable.ic_edit, R.string.y700_alias) { launcher, app ->
+        val history = DrawerHistory(launcher)
+        val input = EditText(launcher).apply { setSingleLine(); setText(history.alias(app)); hint = app.title }
+        android.app.AlertDialog.Builder(launcher).setTitle(R.string.y700_alias).setView(input)
+            .setPositiveButton(android.R.string.ok) { _, _ -> history.setAlias(app, input.text.toString()) }
+            .setNegativeButton(android.R.string.cancel, null).show()
+    }
+}
