index 0000000..cabf5a5
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/y700/DrawerHistory.kt
@@ -0,0 +1,39 @@
+package app.lawnchair.y700
+
+import android.content.Context
+import com.android.launcher3.model.data.AppInfo
+import com.android.launcher3.model.data.ItemInfo
+import java.util.Locale
+
+/** Launcher-originated launches only. No Usage Access, network or cloud dependency. */
+class DrawerHistory(context: Context) {
+    private val prefs = context.applicationContext.getSharedPreferences("y700_drawer_local", Context.MODE_PRIVATE)
+    fun key(item: ItemInfo): String = "${item.targetComponent?.flattenToString()}#${item.user}"
+    fun alias(item: ItemInfo): String = prefs.getString("alias:${key(item)}", "").orEmpty()
+    fun setAlias(item: ItemInfo, value: String) { prefs.edit().putString("alias:${key(item)}", value.trim()).apply() }
+    fun count(item: ItemInfo): Int = prefs.getInt("count:${key(item)}", 0)
+    fun record(item: ItemInfo) {
+        if (item.targetComponent == null) return
+        prefs.edit().putInt("count:${key(item)}", (count(item) + 1).coerceAtMost(1000000))
+            .putLong("last:${key(item)}", System.currentTimeMillis()).apply()
+    }
+    private fun members(kind: String) = prefs.getStringSet(kind, emptySet()).orEmpty().toSet()
+    fun contains(kind: String, item: ItemInfo) = key(item) in members(kind)
+    fun toggle(kind: String, item: ItemInfo) {
+        val entries = members(kind).toMutableSet()
+        if (!entries.add(key(item))) entries.remove(key(item))
+        prefs.edit().putStringSet(kind, entries).apply()
+    }
+    fun clear(kind: String) { prefs.edit().remove(kind).apply() }
+    fun score(item: ItemInfo, now: Long = System.currentTimeMillis()): Double {
+        val last = prefs.getLong("last:${key(item)}", 0)
+        return DrawerRank.score(count(item), last, now)
+    }
+    fun recommendations(apps: List<AppInfo>, hidden: Set<String>, limit: Int): List<AppInfo> {
+        val available = apps.filter { it.toComponentKey().toString() !in hidden && !contains("excluded", it) }
+        val now = System.currentTimeMillis()
+        return available.sortedWith(compareByDescending<AppInfo> { contains("pinned", it) }
+            .thenByDescending { score(it, now) }.thenBy { it.title.toString().lowercase(Locale.ROOT) }
+            .thenBy { key(it) }).take(limit)
+    }
+}
