+package app.lawnchair.search.algorithms
+
+import android.icu.text.Transliterator
+import android.os.Build
+import android.util.LruCache
+import androidx.annotation.RequiresApi
+import java.text.Normalizer
+import java.util.Locale
+
+/** Additional aliases for Chinese app names in the drawer and global search. */
+internal class ChineseAppSearch(query: String) {
+    private val hasHanQuery = containsHan(query)
+    private val pinyinQuery = foldPinyin(query)
+    private val simplifiedQuery = if (Build.VERSION.SDK_INT >= 29 && hasHanQuery) {
+        ChineseAliases.simplified(query)
+    } else {
+        ""
+    }
+
+    fun matches(title: String): Boolean {
+        if (Build.VERSION.SDK_INT < 29 || pinyinQuery.isEmpty() || !containsHan(title)) return false
+        val aliases = ChineseAliases.forTitle(title)
+        return if (hasHanQuery) {
+            aliases.simplified.contains(simplifiedQuery)
+        } else {
+            aliases.pinyin.contains(pinyinQuery) || aliases.initials.startsWith(pinyinQuery)
+        }
+    }
+}
+
+private fun containsHan(value: String): Boolean =
+    value.codePoints().anyMatch { Character.UnicodeScript.of(it) == Character.UnicodeScript.HAN }
+
+private val pinyinSeparators = Regex("[\\s'’-]+")
+private val accents = Regex("\\p{M}+")
+
+private fun foldPinyin(value: String): String =
+    Normalizer.normalize(value.lowercase(Locale.ROOT), Normalizer.Form.NFD)
+        .replace(accents, "")
+        .replace(pinyinSeparators, "")
+
+@RequiresApi(29)
+private object ChineseAliases {
+    data class Aliases(val simplified: String, val pinyin: String, val initials: String)
+
+    private val simplify = Transliterator.getInstance("Traditional-Simplified")
+    private val romanize = Transliterator.getInstance("Han-Latin")
+    private val cache = LruCache<String, Aliases>(1024)
+
+    @Synchronized
+    fun simplified(value: String): String = simplify.transliterate(value).lowercase(Locale.ROOT)
+
+    @Synchronized
+    fun forTitle(title: String): Aliases {
+        cache.get(title)?.let { return it }
+        val simplified = simplified(title)
+        val romanized = romanize.transliterate(simplified)
+        val initials = romanized.split(pinyinSeparators)
+            .filter(String::isNotEmpty)
+            .joinToString("") { foldPinyin(it).take(1) }
+        return Aliases(simplified, foldPinyin(romanized), initials).also { cache.put(title, it) }
+    }
+}
